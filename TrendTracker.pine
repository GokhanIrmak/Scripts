//@version=5
// ─────────────────────────────────────────────────────────────
//  TrendTracker v2 — persistent regime with hysteresis
//  Fixes v1 noise: cloud color is now a STATE, not a per-bar vote.
//  Regime flips only when score crosses ±threshold AND holds for
//  N consecutive bars. Between flips, color never flickers.
// ─────────────────────────────────────────────────────────────
indicator("TrendTracker v2", shorttitle="TrendTracker", overlay=true)

// ── Inputs ───────────────────────────────────────────────────
fastLen    = input.int(21,  "Fast cloud edge (EMA)", minval=2,  group="Cloud")
slowLen    = input.int(50,  "Slow cloud edge (EMA)", minval=5,  group="Cloud")
adxLen     = input.int(14,  "ADX / DMI length",      minval=2,  group="Engine")
adxTrend   = input.int(25,  "ADX: trending above",              group="Engine")
adxChop    = input.int(20,  "ADX: chop below",                  group="Engine")
useHTF     = input.bool(true, "Higher-timeframe confirmation",  group="Engine")
htfTF      = input.timeframe("W", "Confirmation timeframe",     group="Engine")
flipThresh = input.int(30, "Flip threshold (score must exceed ±this)", minval=5, maxval=80, group="Hysteresis")
confirmBars= input.int(3,  "Confirmation bars (must hold that long)",  minval=1, maxval=10, group="Hysteresis")
showFlips  = input.bool(true, "Show regime flip markers",       group="Display")
showTable  = input.bool(true, "Show status table",              group="Display")

// ── Cloud lines ──────────────────────────────────────────────
fastMA = ta.ema(close, fastLen)
slowMA = ta.ema(close, slowLen)

// ── Hidden engine ────────────────────────────────────────────
[diP, diM, adxV]    = ta.dmi(adxLen, adxLen)
[macdL, sigL, hist] = ta.macd(close, 12, 26, 9)

f_histClosed() =>
    [_m, _s, _h] = ta.macd(close, 12, 26, 9)
    _h[1]
htfHist = request.security(syminfo.tickerid, htfTF, f_histClosed(), lookahead = barmerge.lookahead_on)

sEMA   = (close > fastMA ? 0.5 : -0.5) + (fastMA > slowMA ? 0.5 : -0.5)
sSlope = slowMA > slowMA[3] ? 1.0 : -1.0
sMACD  = hist > 0 ? 1.0 : -1.0
sDMI   = diP > diM ? 1.0 : -1.0
sHTF   = htfHist > 0 ? 1.0 : -1.0

wEMA   = 0.30
wSlope = 0.10
wMACD  = 0.20
wDMI   = 0.15
wHTF   = useHTF ? 0.25 : 0.0
wSum   = wEMA + wSlope + wMACD + wDMI + wHTF
score  = (sEMA*wEMA + sSlope*wSlope + sMACD*wMACD + sDMI*wDMI + sHTF*wHTF) / wSum * 100

// ── Persistent regime with hysteresis ────────────────────────
// Count consecutive bars the score has held beyond each threshold
upHold = score >  flipThresh
dnHold = score < -flipThresh
upBars = upHold ? nz(ta.barssince(not upHold), bar_index) + 1 : 0
dnBars = dnHold ? nz(ta.barssince(not dnHold), bar_index) + 1 : 0

var int regime = 0
flipUp = regime !=  1 and upBars >= confirmBars
flipDn = regime != -1 and dnBars >= confirmBars
if flipUp
    regime :=  1
if flipDn
    regime := -1

trending = adxV >= adxTrend
chop     = adxV <= adxChop

// ── Cloud rendering — color comes from the persistent regime ─
baseCol    = regime == 1 ? color.green : regime == -1 ? color.red : color.gray
fillTransp = trending ? 70 : chop ? 92 : 84
lineTransp = trending ? 25 : 60

pFast = plot(fastMA, "Fast edge", color = color.new(baseCol, lineTransp), linewidth = 1)
pSlow = plot(slowMA, "Slow edge", color = color.new(color.gray, 65),      linewidth = 1)
fill(pFast, pSlow, color = color.new(baseCol, fillTransp), title = "Trend cloud")

// ── Flip markers (rare by construction now) ──────────────────
plotshape(showFlips and flipUp, title="Flip UP",   style=shape.xcross, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny)
plotshape(showFlips and flipDn, title="Flip DOWN", style=shape.xcross, location=location.abovebar, color=color.new(color.red, 0),   size=size.tiny)

// ── Status table ─────────────────────────────────────────────
var table t = table.new(position.top_right, 2, 3, bgcolor = color.new(color.black, 30), border_width = 1)
if showTable and barstate.islast
    regTxt   = regime == 1 ? "UP" : regime == -1 ? "DOWN" : "NEUTRAL"
    stateTxt = chop ? regTxt + " · chop" : trending ? regTxt + " · strong" : regTxt + " · weak"
    stateCol = regime == 1 ? color.green : regime == -1 ? color.red : color.gray
    table.cell(t, 0, 0, "Regime", text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 0, stateTxt, text_color = stateCol,     text_size = size.small)
    table.cell(t, 0, 1, "Score",  text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 1, str.tostring(score, "#.0"), text_color = stateCol, text_size = size.small)
    table.cell(t, 0, 2, "ADX",    text_color = color.silver, text_size = size.small)
    table.cell(t, 1, 2, str.tostring(adxV, "#.0"), text_color = trending ? color.yellow : color.gray, text_size = size.small)

// ── Alerts ───────────────────────────────────────────────────
alertcondition(flipUp, "Trend flip UP",   "TrendTracker v2: regime flipped UP (confirmed)")
alertcondition(flipDn, "Trend flip DOWN", "TrendTracker v2: regime flipped DOWN (confirmed)")
