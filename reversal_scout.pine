// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Reversal Scout - Dip / Tepe Avcisi
// "A'dan Z'ye Borsaya Yatirim Rehberi" teknik analiz bolumune dayali tukenis (exhaustion) tespiti.
//   - RSI uclari (s.49: 30/70'de yon degisimi beklenir)
//   - Bollinger band dokunusu (s.49-50: band sinirinda ortalamaya donus)
//   - Hacim spike (s.42: en yuksek hacimler fiyat uclarinda olusur)
//   - MACD teyidi (opsiyonel, s.48)
//   - Hareketli Ortalama trend referansi (s.46)
// CloudTrend ve OB/OS Tracker ile birlikte kullanim icin.

//@version=6
indicator("Reversal Scout", shorttitle="RevScout", overlay=true)

// ============================================================================
// AYARLAR
// ============================================================================

minConditions = input.int(3, "Minimum Conditions to Trigger", minval=2, maxval=3, group="Signal", tooltip="Kac kosul ayni anda saglanmali. 3 = kati (az ama guclu sinyal), 2 = esnek (daha cok sinyal).")

rsiLen = input.int(14, "RSI Length",      minval=2, group="RSI")
rsiOB  = input.int(70, "RSI Overbought",  minval=50, maxval=95, group="RSI")
rsiOS  = input.int(30, "RSI Oversold",    minval=5,  maxval=50, group="RSI")

bbLen  = input.int(20, "BB Length",   minval=5, group="Bollinger")
bbMult = input.float(2.0, "BB StdDev", minval=1.0, maxval=4.0, step=0.1, group="Bollinger")

volLen  = input.int(20, "Volume MA Length", minval=5, group="Volume")
volMult = input.float(1.5, "Volume Spike Multiplier", minval=1.0, maxval=5.0, step=0.1, group="Volume", tooltip="Hacim, ortalamanin bu kat kadar ustundeyse 'spike' sayilir.")

useMACD  = input.bool(false, "Use MACD Confirmation", group="MACD", tooltip="Acikken sinyal icin MACD momentum teyidi de gerekir (4. kosul, AND).")
macdFast = input.int(12, "MACD Fast",   minval=2, group="MACD")
macdSlow = input.int(26, "MACD Slow",   minval=5, group="MACD")
macdSig  = input.int(9,  "MACD Signal", minval=2, group="MACD")

showTrend = input.bool(true, "Show Trend EMA", group="Trend")
trendLen  = input.int(200, "Trend EMA Length", minval=20, maxval=500, group="Trend")

showBands = input.bool(true, "Show Bollinger Bands", group="Display")
showLabels = input.bool(true, "Show AL/SAT Labels", group="Display", tooltip="Kapaliyken sadece ok isareti, yazi yok.")

// ============================================================================
// HESAPLAMA
// ============================================================================

rsi = ta.rsi(close, rsiLen)
[bbMid, bbUp, bbLo] = ta.bb(close, bbLen, bbMult)
volMA = ta.sma(volume, volLen)

// Tepe (SAT) kosullari
topRSI = rsi >= rsiOB
topBB  = high >= bbUp
topVol = volume >= volMA * volMult
topCount = (topRSI ? 1 : 0) + (topBB ? 1 : 0) + (topVol ? 1 : 0)

// Dip (AL) kosullari
botRSI = rsi <= rsiOS
botBB  = low <= bbLo
botVol = volume >= volMA * volMult
botCount = (botRSI ? 1 : 0) + (botBB ? 1 : 0) + (botVol ? 1 : 0)

// MACD teyidi (opsiyonel)
[macdLine, sigLine, _hist] = ta.macd(close, macdFast, macdSlow, macdSig)
macdTopOK = not useMACD or macdLine < sigLine
macdBotOK = not useMACD or macdLine > sigLine

// Sinyaller (rising-edge: kosul ilk saglandiginda bir kez)
topRaw    = topCount >= minConditions and macdTopOK
botRaw    = botCount >= minConditions and macdBotOK
topSignal = topRaw and not topRaw[1]
botSignal = botRaw and not botRaw[1]

// Trend referansi
trendEMA  = ta.ema(close, trendLen)
isUptrend = close > trendEMA

// ============================================================================
// CIZIM
// ============================================================================

plot(showTrend ? trendEMA : na, "Trend EMA", color=color.new(#FFFFFF, 40), linewidth=2)

pUp = plot(showBands ? bbUp : na, "BB Upper", color=color.new(#787B86, 70))
pLo = plot(showBands ? bbLo : na, "BB Lower", color=color.new(#787B86, 70))
fill(pUp, pLo, color=showBands ? color.new(#787B86, 95) : na, title="BB Fill")

// Sinyal rengi: 3/3 parlak (guclu), 2/3 sonuk
topColor = topCount >= 3 ? color.new(#FF1744, 0) : color.new(#FF1744, 45)
botColor = botCount >= 3 ? color.new(#00E676, 0) : color.new(#00E676, 45)

plotshape(topSignal, "Top / SAT", style=shape.triangledown, location=location.abovebar, color=topColor, text="SAT", textcolor=color.white, size=size.small, display=showLabels ? display.all : display.none)
plotshape(botSignal, "Bottom / AL", style=shape.triangleup, location=location.belowbar, color=botColor, text="AL", textcolor=color.white, size=size.small, display=showLabels ? display.all : display.none)

// Etiketsiz mod: sadece ok
plotshape(not showLabels and topSignal, "Top arrow", style=shape.triangledown, location=location.abovebar, color=topColor, size=size.small)
plotshape(not showLabels and botSignal, "Bottom arrow", style=shape.triangleup, location=location.belowbar, color=botColor, size=size.small)

// ============================================================================
// UYARILAR
// ============================================================================

alertcondition(topSignal, title="Top Reversal (SAT)",    message="RevScout: TEPE sinyali - olasi donus {{ticker}} @ {{close}}")
alertcondition(botSignal, title="Bottom Reversal (AL)",  message="RevScout: DIP sinyali - olasi donus {{ticker}} @ {{close}}")
