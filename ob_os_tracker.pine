// Overbought / Oversold Tracker
// RSI tabanli, ayri panelde noktali gosterim (CloudTrend ile birlikte kullanim icin)

//@version=5
indicator("OB/OS Tracker", shorttitle="OB/OS", overlay=false)

// ============================================================================
// AYARLAR
// ============================================================================

rsiLen        = input.int(14, title="RSI Length", minval=2, group="RSI")
obLevel       = input.int(70, title="Overbought Level", minval=50, maxval=95, group="Levels")
osLevel       = input.int(30, title="Oversold Level",   minval=5,  maxval=50, group="Levels")
showZoneFill  = input.bool(true, title="Shade OB/OS Zones", group="Display")

// ============================================================================
// HESAPLAMA
// ============================================================================

rsiValue = ta.rsi(close, rsiLen)

isOverbought = rsiValue >= obLevel
isOversold   = rsiValue <= osLevel
isMid        = not isOverbought and not isOversold

// Renk: yesil = overbought, kirmizi = oversold, mavi = mid
dotColor = isOverbought ? #00E676 : isOversold ? #FF1744 : #2979FF

// ============================================================================
// CIZIM
// ============================================================================

// Noktali RSI cizgisi (fotograftaki gibi)
plot(rsiValue, title="RSI Line", color=color.new(#555555, 60), linewidth=1)
plot(rsiValue, title="RSI Dots",  color=dotColor, linewidth=4, style=plot.style_circles)

// Seviye cizgileri
hlineOB  = hline(obLevel, title="Overbought", color=color.new(#00E676, 50), linestyle=hline.style_dashed)
hlineMid = hline(50,      title="Midline",    color=color.new(#888888, 60), linestyle=hline.style_dotted)
hlineOS  = hline(osLevel, title="Oversold",   color=color.new(#FF1744, 50), linestyle=hline.style_dashed)

// OB/OS bolge golgelemesi
hlineTop = hline(100, title="Top", display=display.none)
hlineBot = hline(0,   title="Bot", display=display.none)
fill(hlineTop, hlineOB, color=showZoneFill ? color.new(#00E676, 92) : na, title="OB Zone")
fill(hlineOS,  hlineBot, color=showZoneFill ? color.new(#FF1744, 92) : na, title="OS Zone")

// ============================================================================
// UYARILAR
// ============================================================================

enterOB = isOverbought and not isOverbought[1]
exitOB  = not isOverbought and isOverbought[1]
enterOS = isOversold and not isOversold[1]
exitOS  = not isOversold and isOversold[1]

alertcondition(enterOB, title="Enter Overbought", message="OB/OS: Asiri alim bolgesine girdi {{ticker}} (RSI>{{plot_0}})")
alertcondition(exitOB,  title="Exit Overbought",  message="OB/OS: Asiri alim bolgesinden cikti {{ticker}}")
alertcondition(enterOS, title="Enter Oversold",   message="OB/OS: Asiri satim bolgesine girdi {{ticker}} (RSI<{{plot_0}})")
alertcondition(exitOS,  title="Exit Oversold",    message="OB/OS: Asiri satim bolgesinden cikti {{ticker}}")
