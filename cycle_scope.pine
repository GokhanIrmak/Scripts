// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Cycle Scope v2 (Hybrid) - Composite cycle position tracker
// BTC, Altin, Hisse / Endeks - hepsinde calisir. On-chain alternatifi olarak fiyat-temelli.
//
// v2 eklemeler:
//   - Composite scoring (Mayer + MTF RSI + Momentum) - opsiyonel
//   - Trend filter (zone'a girdi ama trend uyumsuz = zayif sinyal)
//   - Cooldown (ayni yonde sinyal spamini onler)
//   - Divergence detection

//@version=6
indicator("Cycle Scope", shorttitle="CycleScope", overlay=false)

// ============================================================================
// AYARLAR - CYCLE
// ============================================================================

autoTF    = input.bool(true, "Auto-Adapt to Timeframe", group="Cycle", tooltip="Acikken chart timeframe'ine gore otomatik longMA ve lookback secer.")
longMA    = input.int(200, "Long MA Length (manual)", minval=20, maxval=500, group="Cycle")
lookback  = input.int(300, "Lookback (manual)", minval=50, maxval=2000, group="Cycle")
normMode  = input.string("Z-Score", "Normalization", options=["Percentile Rank", "Z-Score"], group="Cycle", tooltip="Z-Score: kac sigma. Percentile: gecmisin yuzde kaci. Z-Score kisa veride bile calisir.")
smoothLen = input.int(8, "Output Smoothing", minval=1, maxval=30, group="Cycle", tooltip="Composite skoru yumusatmak icin HMA periyodu. 1 = yumusatma yok.")

// ============================================================================
// AYARLAR - COMPOSITE
// ============================================================================

useComposite = input.bool(true, "Use Composite Scoring", group="Composite", tooltip="Acik: Mayer + MTF RSI + Momentum birlesik. Kapali: sadece klasik Mayer.")
wMayer = input.float(0.50, "Mayer weight",        minval=0, maxval=1, step=0.05, group="Composite")
wRSI   = input.float(0.25, "MTF RSI weight",      minval=0, maxval=1, step=0.05, group="Composite")
wMom   = input.float(0.25, "Momentum/ROC weight", minval=0, maxval=1, step=0.05, group="Composite")

// ============================================================================
// AYARLAR - MTF RSI
// ============================================================================

rsiLen       = input.int(14, "RSI Length", minval=2, maxval=50, group="MTF RSI")
useDailyRSI  = input.bool(true, "Use Daily RSI",      group="MTF RSI")
useWeeklyRSI = input.bool(true, "Use Weekly RSI",     group="MTF RSI")
useChartRSI  = input.bool(true, "Use Current TF RSI", group="MTF RSI")

// ============================================================================
// AYARLAR - ZONES & TREND FILTER
// ============================================================================

topZone      = input.int(80, "Top Zone (Euphoria)",        minval=60, maxval=99, group="Zones")
bottomZone   = input.int(20, "Bottom Zone (Capitulation)", minval=1,  maxval=40, group="Zones")
showZoneFill = input.bool(true, "Shade Top/Bottom Zones", group="Zones")

useTrendFilter = input.bool(true, "Apply Trend Filter", group="Trend Filter", tooltip="Acik: trend uyumsuz zone'lar ZAYIF (sonuk renk). Uyumlu olunca GUCLU (parlak renk + alert).")
trendEMALen    = input.int(100, "Trend EMA Length", minval=20, maxval=500, group="Trend Filter")

// ============================================================================
// AYARLAR - COOLDOWN
// ============================================================================

useCooldown  = input.bool(true, "Enable Signal Cooldown", group="Cooldown", tooltip="Ayni yondeki sinyaller arasinda minimum bar mesafesi. Spam'i onler.")
cooldownBars = input.int(60, "Min Bars Between Same-Direction Signals", minval=5, maxval=500, group="Cooldown")

// ============================================================================
// AYARLAR - DIVERGENCE
// ============================================================================

showDiv     = input.bool(true, "Show Divergences", group="Divergence")
divLookback = input.int(5, "Pivot Lookback", minval=2, maxval=20, group="Divergence", tooltip="Pivot tespiti icin sol/sag bar sayisi. Yuksek = onemli pivotlar, gec uyari.")
zoneFilter  = input.bool(true, "Filter to Near Extreme Zones", group="Divergence")

// ============================================================================
// AYARLAR - REVERSAL CANDLES
// ============================================================================

showReversal  = input.bool(true, "Show Reversal Candles in Zone", group="Reversal Candles", tooltip="Tepe/dip bolgesinde donus mumlarini (uzun fitil veya engulfing) elmas isaretiyle gosterir. Divergence'tan farkli, daha hizli sinyal verir.")
reversalRange = input.int(8, "Zone Tolerance (points)", minval=0, maxval=20, group="Reversal Candles", tooltip="Zone'a tam girmemis ama yakindaki donus mumlarini yakalamak icin tampon. Yuksek = daha fazla sinyal.")
wickRatio     = input.float(2.0, "Min Wick / Body Ratio", minval=1.0, maxval=5.0, step=0.1, group="Reversal Candles", tooltip="Fitilin govdeye orani. 2.0 = fitil govdeden 2 kat uzun olmali.")

// ============================================================================
// AYARLAR - DISPLAY
// ============================================================================

showLabel = input.bool(false, "Show Current Score Label", group="Display", tooltip="Grafigin sag kenarinda Cycle: XX yazisini gosterir. Kapatmak son barlari daha iyi gormeyi saglar.")

// ============================================================================
// TIMEFRAME-ADAPTIVE PARAMETRELER
// ============================================================================

autoLongMA   = timeframe.ismonthly ? 12  : timeframe.isweekly ? 50  : timeframe.isintraday ? 100 : 200
autoLookback = timeframe.ismonthly ? 60  : timeframe.isweekly ? 200 : timeframe.isintraday ? 500 : 365

effLongMA   = autoTF ? autoLongMA   : longMA
effLookback = autoTF ? autoLookback : lookback

// ============================================================================
// BILESEN 1: MAYER (fiyat / uzun MA sapmasi)
// ============================================================================

longMean = ta.sma(close, effLongMA)
ratio    = math.log(close / longMean)

prScore = ta.percentrank(ratio, effLookback)
ratMean = ta.sma(ratio, effLookback)
ratSD   = ta.stdev(ratio, effLookback)
zRaw    = ratSD > 0 ? (ratio - ratMean) / ratSD : 0.0
zScore  = math.max(0.0, math.min(100.0, 50.0 + zRaw * (50.0 / 3.0)))

mayerScore = normMode == "Percentile Rank" ? (na(prScore) ? zScore : prScore) : zScore

// ============================================================================
// BILESEN 2: MTF RSI (gunluk + haftalik + chart)
// ============================================================================

rsiChart  = ta.rsi(close, rsiLen)
rsiDaily  = request.security(syminfo.tickerid, "D", ta.rsi(close, rsiLen), lookahead=barmerge.lookahead_off)
rsiWeekly = request.security(syminfo.tickerid, "W", ta.rsi(close, rsiLen), lookahead=barmerge.lookahead_off)

rsiCount = (useDailyRSI ? 1 : 0) + (useWeeklyRSI ? 1 : 0) + (useChartRSI ? 1 : 0)
rsiSum   = (useDailyRSI ? rsiDaily : 0) + (useWeeklyRSI ? rsiWeekly : 0) + (useChartRSI ? rsiChart : 0)
rsiScore = rsiCount > 0 ? rsiSum / rsiCount : 50.0

// ============================================================================
// BILESEN 3: MOMENTUM / ROC
// ============================================================================

rocLen   = math.max(20, effLongMA / 4)
rocVal   = ta.roc(close, rocLen)
rocMean  = ta.sma(rocVal, effLookback)
rocSD    = ta.stdev(rocVal, effLookback)
rocZ     = rocSD > 0 ? (rocVal - rocMean) / rocSD : 0.0
momScore = math.max(0.0, math.min(100.0, 50.0 + rocZ * (50.0 / 3.0)))

// ============================================================================
// COMPOSITE SCORE
// ============================================================================

totalW       = wMayer + wRSI + wMom
totalW      := totalW > 0 ? totalW : 1.0
compositeRaw = (wMayer * mayerScore + wRSI * rsiScore + wMom * momScore) / totalW

selectedScore = useComposite ? compositeRaw : mayerScore
cycleScore    = smoothLen > 1 ? ta.hma(selectedScore, smoothLen) : selectedScore

// ============================================================================
// TREND FILTER
// ============================================================================

trendEMA  = ta.ema(close, trendEMALen)
isUptrend = close > trendEMA

isTopRaw    = cycleScore >= topZone
isBottomRaw = cycleScore <= bottomZone

// Strong = trend confirms the cycle exhaustion
isTopStrong    = isTopRaw    and not isUptrend
isTopWeak      = isTopRaw    and isUptrend
isBottomStrong = isBottomRaw and isUptrend
isBottomWeak   = isBottomRaw and not isUptrend

// Trend filter ON: sadece STRONG zone'lar effective top/bottom sayilir
isTop    = useTrendFilter ? isTopStrong    : isTopRaw
isBottom = useTrendFilter ? isBottomStrong : isBottomRaw

// ============================================================================
// COOLDOWN
// ============================================================================

var int lastTopBar    = na
var int lastBottomBar = na

enterTopRaw    = isTop    and not isTop[1]
enterBottomRaw = isBottom and not isBottom[1]

topCooldownOK    = na(lastTopBar)    or (bar_index - lastTopBar)    >= cooldownBars
bottomCooldownOK = na(lastBottomBar) or (bar_index - lastBottomBar) >= cooldownBars

enterTop    = enterTopRaw    and (not useCooldown or topCooldownOK)
enterBottom = enterBottomRaw and (not useCooldown or bottomCooldownOK)

if enterTop
    lastTopBar    := bar_index
if enterBottom
    lastBottomBar := bar_index

// Dot color
color cTopBright = #00E676
color cTopMuted  = color.new(#00E676, 65)
color cBotBright = #FF1744
color cBotMuted  = color.new(#FF1744, 65)
color cMid       = #2979FF

dotColorFiltered = isTopStrong ? cTopBright : isTopWeak ? cTopMuted : isBottomStrong ? cBotBright : isBottomWeak ? cBotMuted : cMid
dotColorRaw      = isTopRaw    ? cTopBright : isBottomRaw ? cBotBright : cMid
dotColor         = useTrendFilter ? dotColorFiltered : dotColorRaw

// ============================================================================
// DIVERGENCE
// ============================================================================

piH = ta.pivothigh(cycleScore, divLookback, divLookback)
piL = ta.pivotlow(cycleScore,  divLookback, divLookback)

var float prevPiH      = na
var float prevPiHPrice = na
var float prevPiL      = na
var float prevPiLPrice = na

bearDiv = false
bullDiv = false

if not na(piH)
    pivotPrice = high[divLookback]
    if not na(prevPiH) and pivotPrice > prevPiHPrice and piH < prevPiH
        zoneOK = not zoneFilter or piH >= topZone - 10 or prevPiH >= topZone - 10
        bearDiv := zoneOK
    prevPiH      := piH
    prevPiHPrice := pivotPrice

if not na(piL)
    pivotPrice = low[divLookback]
    if not na(prevPiL) and pivotPrice < prevPiLPrice and piL > prevPiL
        zoneOK = not zoneFilter or piL <= bottomZone + 10 or prevPiL <= bottomZone + 10
        bullDiv := zoneOK
    prevPiL      := piL
    prevPiLPrice := pivotPrice

// ============================================================================
// REVERSAL CANDLE DETECTION (zone'da donus mumlari)
// ============================================================================

body      = math.abs(close - open)
upperWick = high - math.max(close, open)
lowerWick = math.min(close, open) - low
avgBody   = ta.sma(body, 20)
smallBody = body < avgBody * 1.5

// Bearish patterns: uzun ust fitil VEYA bearish engulfing
shootingStar  = upperWick > wickRatio * body and smallBody
bearEngulfing = close < open and close[1] > open[1] and open >= close[1] and close <= open[1]
bearReversal  = shootingStar or bearEngulfing

// Bullish patterns: uzun alt fitil VEYA bullish engulfing
hammerCandle  = lowerWick > wickRatio * body and smallBody
bullEngulfing = close > open and close[1] < open[1] and open <= close[1] and close >= open[1]
bullReversal  = hammerCandle or bullEngulfing

// Zone yakinligi (tam zone disi olsa da reversalRange kadar yakininda olsun)
nearTopZone = cycleScore >= (topZone - reversalRange)
nearBotZone = cycleScore <= (bottomZone + reversalRange)

topReversalSignal = showReversal and bearReversal and nearTopZone
botReversalSignal = showReversal and bullReversal and nearBotZone

// ============================================================================
// CIZIM
// ============================================================================

plot(cycleScore, "Cycle Line", color=color.new(#555555, 60), linewidth=1)
plot(cycleScore, "Cycle Dots", color=dotColor, linewidth=4, style=plot.style_circles)

hlineTop    = hline(topZone,    "Top Zone",    color=color.new(#00E676, 50), linestyle=hline.style_dashed)
hline(50,                       "Midline",     color=color.new(#888888, 60), linestyle=hline.style_dotted)
hlineBottom = hline(bottomZone, "Bottom Zone", color=color.new(#FF1744, 50), linestyle=hline.style_dashed)

hlineCap = hline(100, "Cap",   display=display.none)
hlineFlr = hline(0,   "Floor", display=display.none)
fill(hlineCap, hlineTop,    color=showZoneFill ? color.new(#00E676, 92) : na, title="Top Zone Fill")
fill(hlineBottom, hlineFlr, color=showZoneFill ? color.new(#FF1744, 92) : na, title="Bottom Zone Fill")

plotshape(showDiv and bearDiv ? piH : na, "Bearish Divergence", shape.triangledown, location.absolute, color.new(#FF6D00, 0), size=size.small, offset=-divLookback)
plotshape(showDiv and bullDiv ? piL : na, "Bullish Divergence", shape.triangleup,   location.absolute, color.new(#00BCD4, 0), size=size.small, offset=-divLookback)

// Reversal candle isaretleri (zone yakininda donus mumu)
plotshape(topReversalSignal ? cycleScore : na, "Top Reversal Candle",    shape.diamond, location.absolute, color.new(#FF6D00, 0), size=size.tiny)
plotshape(botReversalSignal ? cycleScore : na, "Bottom Reversal Candle", shape.diamond, location.absolute, color.new(#00BCD4, 0), size=size.tiny)

// ============================================================================
// LABEL
// ============================================================================

stateTxt = useTrendFilter ? (isTopStrong ? " (TOP)" : isTopWeak ? " (top-weak)" : isBottomStrong ? " (BOTTOM)" : isBottomWeak ? " (bottom-weak)" : " (MID)") : (isTopRaw ? " (TOP)" : isBottomRaw ? " (BOTTOM)" : " (MID)")
trendTxt = isUptrend ? " | up" : " | down"
labelBg  = useTrendFilter and (isTopWeak or isBottomWeak) ? color.new(#888888, 40) : isTopRaw ? color.new(#00E676, 20) : isBottomRaw ? color.new(#FF1744, 20) : color.new(#2979FF, 20)

var label scoreLabel = na
if barstate.islast and showLabel
    label.delete(scoreLabel)
    txt = "Cycle: " + str.tostring(math.round(cycleScore)) + stateTxt + trendTxt
    scoreLabel := label.new(bar_index, cycleScore, txt, style=label.style_label_left, color=labelBg, textcolor=color.white, size=size.small)

// ============================================================================
// UYARILAR
// ============================================================================

alertcondition(enterTop,    title="Enter Top Zone",    message="CycleScope: TOP zone entered {{ticker}} @ {{close}}")
alertcondition(enterBottom, title="Enter Bottom Zone", message="CycleScope: BOTTOM zone entered {{ticker}} @ {{close}}")
alertcondition(bearDiv,           title="Bearish Divergence",     message="CycleScope: Bearish divergence - olasi tepe {{ticker}} @ {{close}}")
alertcondition(bullDiv,           title="Bullish Divergence",     message="CycleScope: Bullish divergence - olasi dip {{ticker}} @ {{close}}")
alertcondition(topReversalSignal, title="Top Reversal Candle",    message="CycleScope: Top zone'da donus mumu - olasi tepe {{ticker}} @ {{close}}")
alertcondition(botReversalSignal, title="Bottom Reversal Candle", message="CycleScope: Bottom zone'da donus mumu - olasi dip {{ticker}} @ {{close}}")
